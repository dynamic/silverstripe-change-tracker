{
    "name": "dynamic/silverstripe-change-tracker",
    "description": "Records changes to data objects and many_many relations, with the pages each change affects, and shows them in the CMS.",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "keywords": ["silverstripe", "data", "tracker", "audit", "change log"],
    "homepage": "https://github.com/dynamic/silverstripe-change-tracker",
    "authors": [
        {
            "name": "Dynamic",
            "email": "dev@dynamicagency.com",
            "homepage": "https://www.dynamicagency.com"
        },
        {
            "name": "Marcus Nyeholt",
            "email": "marcus@symbiote.com.au",
            "role": "Original author"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silverstripe/cms": "^6",
        "silverstripe/versioned": "^3",
        "silverstripe/admin": "^3"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^4",
        "dnadesign/silverstripe-elemental": "^6",
        "symbiote/silverstripe-queuedjobs": "^6"
    },
    "suggest": {
        "dnadesign/silverstripe-elemental": "Pages are found for changes to content blocks",
        "symbiote/silverstripe-queuedjobs": "Old change records can be pruned by a nightly job"
    },
    "conflict": {
        "symbiote/silverstripe-datachange-tracker": "*",
        "sheadawson/silverstripe-datachange-tracker": "*",
        "silverstripe-australia/datachange-tracker": "*"
    },
    "extra": {
        "expose": [
            "client"
        ]
    },
    "autoload": {
        "psr-4": {
            "Dynamic\\ChangeTracker\\": "src/",
            "Dynamic\\ChangeTracker\\Tests\\": "tests/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
